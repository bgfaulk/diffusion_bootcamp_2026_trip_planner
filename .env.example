DIFFUSION_DATABASE_URL=
DIFFUSION_DATABASE_DATABASE_URL=
GOOGLE_MAPS_API_KEY=
SESSION_SECRET=replace-with-a-long-random-string
# The organizer's sign-in email. Only this account sees the Organizer page (accounts, activity log, reset links).
OWNER_EMAIL=
# A Google "app password" for OWNER_EMAIL (a Gmail account). With it, "Forgot your password?" emails reset
# links and the Organizer page can email them too. Google Account > Security > 2-Step Verification > App passwords.
GMAIL_APP_PASSWORD=
# Invite code the organizer shares with attendees; it gates new accounts (required in production).
SIGNUP_CODE=
WEATHER_API_KEY=
