DIFFUSION_DATABASE_URL=
DIFFUSION_DATABASE_DATABASE_URL=
# Places API (New) key, used server-side for address suggestions. The server forwards the site's origin as the
# Referer, so if the key has HTTP-referrer restrictions they must allow the deployed origin (for example
# https://diffusion-bootcamp-2026-trip-planne.vercel.app/*) and http://localhost:3000/* for development.
GOOGLE_MAPS_API_KEY=
SESSION_SECRET=replace-with-a-long-random-string
# The organizer's sign-in email, or a comma-separated list. Every listed account sees the Organizer page
# (accounts, activity log, reset links); the first one receives alerts and bug reports and sends mail.
OWNER_EMAIL=
# A Google "app password" for the first OWNER_EMAIL (a Gmail account). With it, "Forgot your password?" emails reset
# links and the Organizer page can email them too. Google Account > Security > 2-Step Verification > App passwords.
GMAIL_APP_PASSWORD=
# Invite code the organizer shares with attendees; it gates new accounts (required in production).
SIGNUP_CODE=
WEATHER_API_KEY=
# Invite link for the attendees' WhatsApp group, shown (with a QR code) under "ABC WhatsApp" in the account menu.
# Kept here rather than in code because the repository is public.
WHATSAPP_GROUP_URL=
# Set to any long random string. Vercel sends it as a bearer token when it runs the daily health check
# (vercel.json); without it only the organizer's own session can trigger a check.
CRON_SECRET=
